{
  "name": "jvm-intellisense",
  "displayName": "JVM IntelliSense",
  "description": "Language support for JVM launch options and Java argument files.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "jvm-intellisense",
  "main": "./extension.js",
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onLanguage:jvm-args",
    "onCommand:jvmIntelliSense.selectJdk",
    "onCommand:jvmIntelliSense.validateOptions"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "jvm-args",
        "aliases": [
          "JVM Arguments",
          "jvm-args"
        ],
        "filenames": [
          "jvm.args"
        ],
        "extensions": [
          ".jvmargs",
          ".vmoptions"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jvm-args",
        "scopeName": "source.jvm-args",
        "path": "./syntaxes/jvm-args.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "jvmIntelliSense.selectJdk",
        "title": "JVM IntelliSense: Select JDK"
      },
      {
        "command": "jvmIntelliSense.validateOptions",
        "title": "JVM IntelliSense: Validate Options with Java"
      }
    ],
    "configuration": {
      "title": "JVM IntelliSense",
      "properties": {
        "jvmIntelliSense.javaPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Java executable or a JDK home directory. If empty, the extension detects JAVA_HOME or Java on PATH."
        }
      }
    }
  }
}
