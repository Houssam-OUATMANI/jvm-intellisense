{
  "name": "jvm-intellisense",
  "displayName": "JVM IntelliSense",
  "description": "Language support for JVM launch options and Java argument files.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "houssam-ouatmani",
  "author": "Houssam OUATMANI",
  "repository": {
    "type": "git",
    "url": "https://github.com/Houssam-OUATMANI/jvm-intellisense.git"
  },
  "homepage": "https://github.com/Houssam-OUATMANI/jvm-intellisense.git#readme",
  "bugs": {
    "url": "https://github.com/Houssam-OUATMANI/jvm-intellisense.git#issues"
  },
  "main": "./extension.js",
  "icon": "icon.png",
  "keywords": [
    "java",
    "jvm",
    "intellisense",
    "jvm-args",
    "java-arguments",
    "jvm-options",
    "jdk",
    "hotspot",
    "launch-configuration",
    "vscode-extension"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onLanguage:jvm-args",
    "onCommand:jvmIntelliSense.selectJdk",
    "onCommand:jvmIntelliSense.validateOptions",
    "onStartupFinished"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "jvm-args",
        "aliases": [
          "JVM Arguments",
          "jvm-args"
        ],
        "filenames": [
          "jvm.args"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jvm-args",
        "scopeName": "source.jvm-args",
        "path": "./syntaxes/jvm-args.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "jvmIntelliSense.selectJdk",
        "title": "JVM IntelliSense: Select JDK"
      },
      {
        "command": "jvmIntelliSense.validateOptions",
        "title": "JVM IntelliSense: Validate Options with Java"
      }
    ],
    "configuration": {
      "title": "JVM IntelliSense",
      "properties": {
        "jvmIntelliSense.javaPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Java executable or a JDK home directory. If empty, the extension detects JAVA_HOME or Java on PATH."
        },
        "jvmIntelliSense.fileExtensions": {
          "type": "array",
          "default": [
            ".args",
            ".jvmargs",
            ".vmoptions"
          ],
          "items": {
            "type": "string",
            "pattern": "^\\.[^/\\\\]+$"
          },
          "description": "File extensions to automatically treat as JVM argument files when VS Code otherwise identifies them as Plain Text. Replace the list to customize it; entries must start with a dot."
        }
      }
    }
  }
}
